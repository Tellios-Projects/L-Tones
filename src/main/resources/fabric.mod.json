{
  "schemaVersion": 1,
  "id": "ltones",
  "version": "${version}",

  "name": "L-Tones",
  "description": "A building mod focused on the surreal and otherworldly. \nSpiritual successor to the Z-Tones mod of 1.7.10 days.",
  "authors": [
    "Leah, Tellio, amber meow"
  ],
  "contact": {
    "homepage": "ADDME - website link",
    "sources": "https://github.com/Tellios-Projects/L-Tones"
  },

  "license": "MIT",
  "icon": "assets/ltones/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.leafenzo.ltones.ModInit"
    ],
    "client": [
      "net.leafenzo.ltones.ModClientInit"
    ],
    "fabric-datagen": [
      "net.leafenzo.ltones.datageneration.ModDataGenerator"
    ]
  },
  "mixins": [
    "ltones.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "java": ">=21"
  },
  "suggests": {
    "another-mod": "*"
  }
}
